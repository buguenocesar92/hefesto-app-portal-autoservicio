# ---------------------------------------------------------------------------
# Caddy: unico punto de entrada publico del portal.
# ---------------------------------------------------------------------------
# El navegador habla solo con Caddy. Caddy reparte:
#
#   /api/**   -> contenedor `api` (Laravel)
#   todo lo demas -> contenedor `web` (Nuxt)
#
# POR QUE EL NAVEGADOR NO HABLA DIRECTO CON LA API
# -----------------------------------------------
# La sesion viaja en una cookie HttpOnly + Secure + SameSite=Lax. Con una
# cookie asi, el navegador solo la envia a SU MISMO origen. Si la API
# respondiera en otro origen, habria que resolver CORS con credenciales y
# el token CSRF se volveria mas fragil. Al meter todo en un solo origen, la
# cookie viaja sola y el CSRF se resuelve con la cabecera `X-XSRF-TOKEN`.
#
# VERIFICACION DE CERTIFICADO
# ---------------------------
# Caddy emite y renueva el certificado TLS solo. Si Hefesto usa un
# certificado propio (por ejemplo de una CA contratada), descomentar el
# bloque `tls` de mas abajo y cargar los archivos.
# ---------------------------------------------------------------------------

{
	email {$ACME_EMAIL:admin@hefestostudio.cl}
	# El portal es un sistema de gestion con datos de clientes: la cabecera
	# HSTS obliga al navegador a no volver a HTTP ni aunque alguien lo pida.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Puerto 80 solo para la redireccion y la validacion del certificado.
:80 {
	redir {
		to https://{host}{uri}
	}
}

portal.hefestostudio.cl {
	encode zstd gzip

	# ------------------------------------------------------------------------
	# La API.
	# ------------------------------------------------------------------------
	handle /api/* {
		reverse_proxy api:8080 {
			# El cuerpo puede ser un archivo (por ejemplo, una peticion de
			# descarga), asi que no se fija un limite arbitrario aqui: lo
			# controla Laravel (upload_max_filesize en php.ini).
			transport http {
				read_timeout 60s
			}
		}
	}

	# ------------------------------------------------------------------------
	# Comprobacion de salud interna. NO es publica: se responde sinproxy para
	# que el orquestador y el operador puedan revisarla sin pasar por la
	# aplicacion.
	# ------------------------------------------------------------------------
	handle /salud-interna* {
		respond "ok" 200
	}

	# ------------------------------------------------------------------------
	# La interfaz.
	# ------------------------------------------------------------------------
	handle {
		reverse_proxy web:3000
	}

	# Si Hefesto usa certificado propio, descomentar y montar los archivos:
	#
	# tls /etc/caddy/certs/portal.crt /etc/caddy/certs/portal.key
	#
	log {
		output file /var/log/caddy/acceso.log {
			roll_size 10MiB
			roll_keep 10
		}
		format json
	}
}