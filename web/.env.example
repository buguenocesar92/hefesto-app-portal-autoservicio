# ---------------------------------------------------------------------------
# Variables de entorno de la capa web (Nuxt)
# ---------------------------------------------------------------------------
#
# Plantilla. Copiala a `.env`:
#
#   cp .env.example .env
#
# NUXT_      -> variables PRIVADAS: solo las ve el servidor (BFF).
# NUXT_PUBLIC_ -> variables publicas: llegan al navegador. No poner secretos.
# ---------------------------------------------------------------------------

# URL interna de la API de Laravel. El servidor la usa para reenviar las
# peticiones del navegador. No es una URL publica: es la red interna de Docker
# o localhost.
NUXT_API_BASE=http://localhost:8000

# Origen publico del portal. Se usa para mostrar enlaces en la interfaz.
NUXT_PUBLIC_BASE=http://localhost:3000