# ---------------------------------------------------------------------------
# Variables de entorno de la API del Portal de Autoservicio
# ---------------------------------------------------------------------------
#
# Este archivo es una PLANTILLA. Copielo a `.env` y complete los valores:
#
#   cp .env.example .env
#
# NO hay ningun valor real aqui a proposito. El `.env` nunca se sube al
# repositorio: esta en `.gitignore`.
#
# Generate APP_KEY con: php artisan key:generate
# ---------------------------------------------------------------------------

APP_NAME="Portal de Autoservicio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Santiago

APP_LOCALE=es_CL
APP_FALLBACK_LOCALE=es_CL
APP_FAKER_LOCALE=es_CL

# ---------------------------------------------------------------------------
# Base de datos (PostgreSQL)
# ---------------------------------------------------------------------------
#
# IMPORTANTE PARA EL AISLAMIENTO: el rol de esta conexion NO puede ser
# superusuario ni tener BYPASSRLS. Si lo fuera, PostgreSQL ignoraria las
# politicas de Row Level Security y las Pymes verian los datos unas de otras.
# La comprobacion esta en: php artisan portal:verificar-aislamiento
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=portal_autoservicio
DB_USERNAME=portal_app
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=portal_autoservicio_admin
DB_ADMIN_PASSWORD=

# El rol debe existir con estos atributos (no es superusuario, no es BYPASSRLS):
#   CREATE ROLE portal_app LOGIN PASSWORD '...' NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE;
#   CREATE DATABASE portal_autoservicio OWNER portal_app;

# ---------------------------------------------------------------------------
# Redis (cache y colas)
# ---------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ---------------------------------------------------------------------------
# Sesion
# ---------------------------------------------------------------------------
#
# La sesion va a la base de datos porque la API corre en varios contenedores.
# Con archivos, el usuario perderia la sesion al ser atendido por otra replica.
SESSION_DRIVER=database
SESSION_LIFETIME=120
# En produccion DEBE ser true: sin `Secure`, la cookie viaja en texto plano.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

# Cifrado de la cookie y de la URL de la API.
APP_KEY=
# En produccion, generar uno nuevo con: php artisan key:generate

# ---------------------------------------------------------------------------
# Autenticacion (OIDC contra Authentik)
# ---------------------------------------------------------------------------
#
# Valores tomados del proveedor OAuth2/OpenID Connect de Authentik.
# La URL de redireccion debe estar EXACTAMENTE como esta en el campo
# "Redirect URIs (strict)" del proveedor.
#
# Documentacion oficial:
# https://docs.goauthentik.io/add-secure-apps/providers/oauth2/
AUTHENTIK_ISSUER=https://id.ejemplo.cl/application/o/portal/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
# `openid` es obligatorio: sin el no llega el token de identificacion.
# `profile` entrega el claim `groups`; `email` entrega el correo.
AUTHENTIK_SCOPES="openid profile email"
# Grupo de Authentik que define el primer alta como administrador. Despues
# manda el rol que administra la PyME dentro del portal.
AUTHENTIK_GRUPO_ADMIN=portal-administradores
# Algoritmo de firma del token de identificacion. RS256 si Authentik tiene
# una clave de firma propia; HS256 si firma con el secreto del cliente.
AUTHENTIK_ALGORITMO=RS256
AUTHENTIK_CACHE_SEGUNDOS=3600
AUTHENTIK_TOLERANCIA_MINUTOS=2

# ---------------------------------------------------------------------------
# Documentos
# ---------------------------------------------------------------------------
#
# Ruta RAIZ del volumen de documentos. La tabla `documentos` guarda rutas
# relativas a esta raiz, asi que el volumen se puede mover sin tocar la base.
DOCUMENTOS_PATH=

# ---------------------------------------------------------------------------
# Correo
# ---------------------------------------------------------------------------
# El portal NO envia correos en este primer corte. La invitacion a una
# persona se entrega por el canal que elija la PyME.
MAIL_MAILER=log

# ---------------------------------------------------------------------------
# Registro
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_PORTAL_SEGURIDAD=info